DEFAULT_THREAD_ID=4

# These two are required for Google search API (Programmable Search Engine) availability.

GOOGLE_PSE_API_KEY= ***
GOOGLE_PSE_ENGINE_ID= ***

# Azure OpenAI configuration.
# MODEL_NAME should be your Azure deployment name.

# The resource address only: https://<resource>.cognitiveservices.azure.com/
# (not a full .../openai/deployments/... request URL).
AZURE_AI_ENDPOINT= ***
AZURE_AI_CREDENTIAL= ***
AZURE_API_VERSION=2024-12-01-preview
MODEL_NAME= ***

# Only for models that need them (e.g. gpt-6-luna); leave out for gpt-4.1-mini.
# MODEL_TEMPERATURE=1
# MODEL_TOOL_REASONING_EFFORT=none

# Set to false to turn off memory recall in prompts (e.g. for evals).
# MEMORY_RECALL=true
